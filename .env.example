# Copy to .env and start with: node --env-file=.env src/server.js  (Elozi does not read .env by itself).
MEPCHAT_PORT=4318
MEPCHAT_BIND_ADDRESS=127.0.0.1
# Public HTTPS origin behind your TLS proxy. Leave unset for local http://127.0.0.1 (an http:// value stops startup).
# MEPCHAT_PUBLIC_ORIGIN=https://chat.example.com
# MEPCHAT_TRUSTED_PROXIES=gateway
# MEPCHAT_CONVERSATION_JOURNAL=true
# MEPCHAT_PUBLIC_TRIAL_ENABLED=false
# MEPCHAT_GOOGLE_CLIENT_ID=
# MEPCHAT_EMAIL_FROM=
# MEPCHAT_AGENT_PROFILE_ORIGINS=
# Optional PostgreSQL mirror over SSH (disabled when unset):
# MEPCHAT_POSTGRES_SSH_HOST=db-host.example.test
# MEPCHAT_POSTGRES_CONTAINER=supabase-db
# ELOZI_STRIPE_SECRET_KEY=
# ELOZI_STRIPE_WEBHOOK_SECRET=

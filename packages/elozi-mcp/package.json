    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "start": "node bin/elozi-mcp.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "elozi",
    "customer-service",
    "whatsapp",
    "telegram",
    "helpdesk",
    "claude-desktop",
    "ai-agents"
  ],
  "homepage": "https://elozi.je4ndev.com",
  "repository": {
    "type": "git",
    "url": "https://elozi.je4ndev.com"
  },
  "bugs": {
